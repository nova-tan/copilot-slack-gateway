<?xml version="1.0" encoding="UTF-8"?>
<!-- Install:
  Replace __PROJECT_DIR__ and __HOME_DIR__ with absolute paths first.
  cp launchd/com.example.copilot-slack-gateway.plist ~/Library/LaunchAgents/
  launchctl load ~/Library/LaunchAgents/com.example.copilot-slack-gateway.plist
Logs: __HOME_DIR__/.copilot-slack-gateway/gateway.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.copilot-slack-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/.venv/bin/copilot-slack-gateway</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME_DIR__/.copilot-slack-gateway/gateway.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME_DIR__/.copilot-slack-gateway/gateway.error.log</string>
</dict>
</plist>
